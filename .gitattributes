* text=auto eol=lf
*.sln    text eol=crlf
*.vcxproj text eol=crlf
*.hlsl   text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf
*.cmake  text eol=lf
CMakeLists.txt text eol=lf

# Binary assets 
*.dds binary
*.png binary
*.jpg binary
*.fbx binary
*.gltf binary
*.glb binary
*.wav binary
*.ogg binary
*.fsb binary
*.fbank binary
assets/** filter=lfs diff=lfs merge=lfs -text

assets/shaders/*.hlsl  !filter !diff !merge text eol=lf
assets/shaders/*.hlsli !filter !diff !merge text eol=lf
